# ===================================================================
# LEXIA Backend Environment Variables Template
# ===================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lexia
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# ===================================================================
# JWT CONFIGURATION
# ===================================================================
# Generate a strong secret key (minimum 256 bits / 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# ===================================================================
# EMAIL CONFIGURATION
# ===================================================================
# SMTP server settings (example for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@lexia.com
EMAIL_FROM_NAME=LEXIA

# Email unsubscribe secret
LEXIA_UNSUBSCRIBE_SECRET=your_unsubscribe_secret_key

# ===================================================================
# GOOGLE GEMINI AI CONFIGURATION (Sprint 5)
# ===================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
# CRITICAL: Keep this secret! Never commit to git.
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Override default API URL (only change if using custom endpoint)
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# ===================================================================
# APPLICATION SETTINGS
# ===================================================================
# Server port (default: 8080)
# SERVER_PORT=8080

# Active Spring profile (dev, prod)
# SPRING_PROFILES_ACTIVE=dev

# ===================================================================
# MONITORING & LOGGING
# ===================================================================
# Set to DEBUG for development, INFO for production
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_LEXIA=DEBUG
